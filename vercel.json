{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    {
      "source": "/blog/:slug*",
      "destination": "/blog",
      "permanent": true
    },
    {
      "source": "/blog",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/productions",
      "destination": "https://www.fascinate.media",
      "permanent": true
    },
    {
      "source": "/resources",
      "destination": "/free-ai-assessment",
      "permanent": true
    },
    {
      "source": "/contact",
      "destination": "/#contact",
      "permanent": true
    },
    {
      "source": "/speaking",
      "destination": "/#topics",
      "permanent": true
    },
    {
      "source": "/bio",
      "destination": "/#about",
      "permanent": true
    },
    {
      "source": "/why-stem-is-dope",
      "destination": "/#topics",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/ai-keynote-speaker-corporate", "destination": "/index.html" },
    { "source": "/ai-keynote-speaker-higher-education", "destination": "/index.html" },
    { "source": "/ai-literacy-workshop", "destination": "/index.html" },
    { "source": "/free-ai-assessment", "destination": "/index.html" },
    { "source": "/ai-professional-development", "destination": "/index.html" },
    { "source": "/courses", "destination": "/index.html" },
    { "source": "/TheUniverseGame", "destination": "/index.html" }
  ]
}
